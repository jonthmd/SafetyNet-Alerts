        {
          "name": "Get FireStation by address.",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const data = pm.response.json();\nconst address1 = pm.environment.get(\"address1\");\n\npm.test(\"Status code is 200\", function () {\n    pm.response.to.have.status(200)\n})\n\npm.test(\"Address is correct.\", function () {\n    pm.expect(data.address).to.eql(address1)\n})\n\npm.test(\"La réponse est au format JSON\", function () {\n    pm.response.to.be.json;\n})\n\npm.test(\"La réponse contient des données\", function () {\n    pm.expect(data).to.not.be.null;\n})\n\npm.test(\"Address is not empty\", function () {\n    pm.expect(data.address).to.be.a(\"string\").and.not.empty;\n})"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseURL}}/fireStation/{{address1}}",
              "host": [
                "{{baseURL}}"
              ],
              "path": [
                "fireStation",
                "{{address1}}"
              ]
            }
          },
          "response": []
        },
